# =============================================================================
# MODULAR ADAPTIVE DATA NODE (MADN) — SOVEREIGN ENVIRONMENT SECRETS
# =============================================================================
# COPY THIS FILE TO .env AND SET YOUR UNIQUE SECRETS
# NEVER COMMIT .env TO GIT REPOSITORIES OR GITHUB
# =============================================================================

# 1. Master Vault Heavy Encryption Passphrase
# Used to derive 256-bit AES Master Key via scrypt (N=16384, r=8, p=1)
VAULT_MASTER_PASSWORD=YourCustomSovereignPassphraseHere!2026

# 2. Vault Encryption Salt (Optional: Custom 16+ character salt)
VAULT_ENCRYPTION_SALT=MADN_CUSTOM_NODE_SALT_2026_PROD

# 3. Vault Node Host & Port
VAULT_HOST=127.0.0.1
VAULT_PORT=8000

# 4. Data Node Mesh Discovery & Caching
DATA_NODE_HOST=127.0.0.1
DATA_NODE_PORT=8002
MULTICAST_GROUP=224.0.0.251
MULTICAST_PORT=8001
